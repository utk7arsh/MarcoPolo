{
  "name": "marco-photon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marco Polo's caretaker loop over iMessage, built on Photon 2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sim": "PHOTON_MODE=sim tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@photon-ai/api": "0.5.0",
    "heif2jpeg": "0.1.6",
    "hono": "4.13.13",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "socket.io": "4.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
