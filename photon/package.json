{
  "name": "marco-photon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marco Polo's caretaker loop over iMessage, built on Photon Spectrum",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sim": "PHOTON_MODE=sim tsx src/index.ts",
    "terminal": "PHOTON_MODE=terminal tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@hono/node-ws": "1.3.1",
    "heif2jpeg": "0.1.6",
    "hono": "4.13.13",
    "spectrum-ts": "12.11.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
