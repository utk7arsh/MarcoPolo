# Photon Spectrum: app.photon.codes > your project > Settings. Promo code HACKWITHPHOTON gives Pro free.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# imessage | terminal | sim. Defaults to imessage when SPECTRUM_PROJECT_ID is set, else sim.
PHOTON_MODE=

PORT=8787
# What the phone uses to reach this service (media URLs in events are built from it).
PUBLIC_BASE_URL=http://localhost:8787
# Optional shared secret: phone sends "Authorization: Bearer <token>" (or ?token= on the WebSocket).
BRIDGE_TOKEN=

MARCO_USER_NAME=Dad
# handle=Name pairs. Use the exact handle https://debug.photon.codes reports for each caretaker's phone.
CARETAKERS=+13105550101=Mom
# Who gets "what is this?" photos. Defaults to the first caretaker who texted Marco.
PRIMARY_CARETAKER=+13105550101

# Turns voice memos into names ("That's the cumin, love." -> "cumin"). Without it, voice memos still play.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Main FastAPI server. When set: caretaker photos go to POST /items, answers go to POST /labels/reply.
MARCO_SERVER_URL=

# After a bare photo, wait this long for a caption before asking "what is this?".
PROMPT_DELAY_MS=2500
DATA_DIR=./data
