# Photon 2.0: https://app.beta.photon.codes (project Settings for the ID; API keys for the key).
# The key needs project:read and project:write; add platforms:read if you want `npm run doctor` to show Marco's number.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# photon | sim. Defaults to photon when PHOTON_API_KEY is set, else sim (play the caretaker on /dev/inbound).
PHOTON_MODE=
# PHOTON_API_ORIGIN=https://api.photon.codes

# The Marco server (docs/INTERFACES.md §5). Use its tailscale serve URL, even on the server's own machine, and add
# this machine's tailnet login to the server's TAILSCALE_ALLOWED_LOGINS. Local stub: http://127.0.0.1:8000
# (server started with AUTH_TEST_BYPASS=1).
MARCO_SERVER_URL=

# Local status port (/health; /dev/* in sim mode). Bound to 127.0.0.1 only.
PORT=8787

MARCO_USER_NAME=Dad
# handle=Name pairs: each caretaker's iMessage phone number (E.164) or Apple ID email.
CARETAKERS=+13105550101=Mom
# Who gets "what is this?" photos. Defaults to the first caretaker who texted Marco.
PRIMARY_CARETAKER=+13105550101

# Turns voice memos into names ("That's the cumin, love." -> "cumin"). Without it, a voice memo waits for a typed name.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# After a bare photo, wait this long for a caption before asking "what is this?".
PROMPT_DELAY_MS=2500
DATA_DIR=./data
